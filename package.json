    "@tiptap/extension-image": "^2.6.6",
    "@tiptap/extension-link": "^2.6.6",
    "@tiptap/extension-placeholder": "^2.6.6",
    "@tiptap/pm": "^2.6.6",
    "@tiptap/react": "^2.6.6",
    "@tiptap/starter-kit": "^2.6.6",
    "bcryptjs": "^2.4.3",
    "jose": "^5.6.3",
    "next": "16.2.9",
    "nodemailer": "^9.0.1",
    "qrcode.react": "^4.1.0",
    "react": "^19.2.7",
