# Copy this file to .env (or .env.local) and fill in the values.

# ─── Database (PostgreSQL — e.g. Neon, Supabase, Railway, or local) ───
# Used by Prisma for the blog CMS, leads, SEO settings, and newsletter.
# On Neon: DATABASE_URL = pooled (-pooler) URL, DIRECT_URL = direct URL (migrations).
DATABASE_URL="postgresql://user:password@host:5432/mnt?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/mnt?schema=public"

# ─── Admin panel (single admin) ───
# AUTH_SECRET: any long random string (e.g. `openssl rand -base64 32`)
AUTH_SECRET="change-me-to-a-long-random-string"
ADMIN_EMAIL="admin@mntfuture.com"
# Generate the hash:  npm run hash -- "your-password"
ADMIN_PASSWORD_HASH=""

# Public base URL (used for canonicals, sitemap, RSS, OG)
NEXT_PUBLIC_SITE_URL="https://mntfuture.com"

# ─── Enquiry email ───
# Enquiries (contact form + agentready fix-plan requests) send through Resend,
# the same key as the newsletter below. Two mails go out per enquiry: one to
# the team, one confirming to the person who submitted.
#
# Who gets told about a new enquiry. Comma-separated for more than one person.
LEAD_NOTIFY_TO="syed@mntfuture.com,udhay@mntfuture.com"
# Where a prospect's reply lands — must be a real mailbox someone reads.
LEAD_REPLY_TO="info@mntfuture.com"
# Optional: send enquiry mail from its own address instead of NEWSLETTER_FROM.
LEAD_FROM="MnT Future <hello@mntfuture.com>"

# Legacy fallbacks, used only if the LEAD_* values above are unset.
MAIL_TO=info@mntfuture.com
MAIL_FROM="MnT Website <info@mntfuture.com>"

# ─── Email marketing (Resend) ───
# https://resend.com → verify your domain (DKIM/SPF) → create an API key.
# Without a key, subscribers still save to the DB; only sending is skipped.
RESEND_API_KEY=
NEWSLETTER_FROM="MnT <news@mntfuture.com>"
# Where subscriber replies land — a real mailbox you can read (Zoho/Google/etc.).
NEWSLETTER_REPLY_TO="info@mntfuture.com"

# ─── Scheduled jobs ───
# Secret guarding the cron endpoints. Generate a long random string
# (e.g. `openssl rand -hex 24`). A scheduler then hits:
#   GET https://mntfuture.com/api/cron/follow-up-digest?secret=YOUR_SECRET
#   GET https://mntfuture.com/api/cron/sync-blog?secret=YOUR_SECRET
# sync-blog publishes content/blog-posts.json into the CMS, so the blog can be
# published without the production DATABASE_URL leaving DigitalOcean.
CRON_SECRET=

# ─── Screen-monitoring storage (DigitalOcean Spaces, S3-compatible) ───
# Create a Space + an access key/secret in the DO console, then fill these in.
# Used by the desktop agent's screenshot uploads and the admin viewer.
SPACES_REGION="blr1"
SPACES_BUCKET="mnt-monitoring"
SPACES_KEY=
SPACES_SECRET=
# Optional — defaults to https://<SPACES_REGION>.digitaloceanspaces.com
SPACES_ENDPOINT=
