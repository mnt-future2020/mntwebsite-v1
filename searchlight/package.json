{
  "name": "searchlight",
  "version": "0.0.1",
  "private": true,
  "description": "Searchlight — an autonomous SEO/AEO agent (Monitor -> Fixer -> Verifier). Repo-native, built on the Claude Agent SDK.",
  "bin": {
